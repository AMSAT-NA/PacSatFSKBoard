	(text "This chip does not have a thermal pad on the\nchip, but does have one in the footprint.\nJust apply solder paste normally there so the\nchip will sit on it and have some thermal\npath to the board besides the pins."
		(exclude_from_sim no)
		(at 216.154 149.352 0)
		(effects
			(font
				(size 1.524 1.524)
			)
		)
		(uuid "21c8b8b4-4ffd-4264-9414-59b4b33025ab")
	)
	(text "Thermsistor varies from 534\nohms (125C) to 188.5KΩ (-40C).\nWith a 10KΩ bias this gives a\n.17 to 3.13V range."
		(exclude_from_sim no)
		(at 131.572 160.528 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "4d07b3ca-fd29-4ae3-941b-c7a0838d213a")
	)
