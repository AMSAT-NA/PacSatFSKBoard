		(uuid "4ff5bba1-3e05-4bf0-852a-0da09c96ce4a")
	)
	(text "Place by the Oscillator.\nThis is to adjust frequency\nbased on temperature."
		(exclude_from_sim no)
		(at 150.876 196.088 0)
		(effects
			(font
				(size 1.524 1.524)
			)
		)
		(uuid "8e0ed1d2-f159-46a6-9dc6-5290bc4e9f42")
	)
	(text "AX5043s have capacitive termination\nat the end of the clocks per their\ndata sheet.  Only need series\ntermination on the CPU clock."
		(exclude_from_sim no)
		(at 285.242 111.506 0)
		(effects
